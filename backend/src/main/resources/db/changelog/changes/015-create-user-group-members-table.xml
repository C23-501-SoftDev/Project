<?xml version="1.0" encoding="UTF-8"?>
<!--
    Changelog 015: Создание таблицы user_group_members
    
    Связь "многие-ко-многим" между пользователями и группами.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="015-create-user-group-members-table" author="knowledgebase-dev">
        <comment>Создание таблицы состава групп пользователей</comment>

        <createTable tableName="user_group_members" remarks="Состав групп пользователей">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_user_group_members" nullable="false"/>
            </column>
            <column name="group_id" type="BIGINT" remarks="Группа">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT" remarks="Пользователь">
                <constraints nullable="false"/>
            </column>
            <column name="added_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"
                    remarks="Дата добавления в группу">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Уникальность: пользователь не может дважды входить в одну группу -->
        <addUniqueConstraint
                tableName="user_group_members"
                columnNames="group_id, user_id"
                constraintName="uq_user_group_members"/>

        <!-- Foreign Key constraints -->
        <addForeignKeyConstraint
                baseTableName="user_group_members"
                baseColumnNames="group_id"
                constraintName="fk_user_group_members_group"
                referencedTableName="user_groups"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="user_group_members"
                baseColumnNames="user_id"
                constraintName="fk_user_group_members_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!-- Индексы -->
        <createIndex tableName="user_group_members" indexName="idx_user_group_members_group">
            <column name="group_id"/>
        </createIndex>

        <createIndex tableName="user_group_members" indexName="idx_user_group_members_user">
            <column name="user_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="user_group_members"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
