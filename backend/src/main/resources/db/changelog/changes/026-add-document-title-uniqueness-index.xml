<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="026-add-document-title-uniqueness-index" author="knowledgebase-dev">
        <comment>Добавление уникального индекса для заголовка документа на одном уровне иерархии</comment>
        <addUniqueConstraint tableName="documents"
                             columnNames="title, space_id, parent_document_id"
                             constraintName="uq_documents_title_hierarchy"/>
    </changeSet>

</databaseChangeLog>
