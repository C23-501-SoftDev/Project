<?xml version="1.0" encoding="UTF-8"?>
<!--
    Changelog 018: Удаление is_deleted из таблицы versions
    
    Версии больше не поддерживают soft-delete. Они удаляются каскадно при hard-delete документа.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="018-remove-is-deleted-from-versions" author="knowledgebase-dev">
        <comment>Удаление колонки is_deleted из таблицы versions</comment>

        <dropColumn tableName="versions" columnName="is_deleted"/>

        <rollback>
            <addColumn tableName="versions">
                <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                    <constraints nullable="false"/>
                </column>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
