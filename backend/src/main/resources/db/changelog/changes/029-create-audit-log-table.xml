<?xml version="1.0" encoding="UTF-8"?>
<!--
    Changelog 029: Создание таблицы audit_log (US4.1.5 — Логирование действий системы)

    Хранит журнал критических действий пользователей:
    операции над документами, пространствами, пользователями, группами и правами доступа.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="029-create-audit-log-table" author="knowledgebase-dev">
        <comment>Создание таблицы журнала аудита действий системы</comment>

        <createTable tableName="audit_log" remarks="Журнал аудита действий пользователей">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_audit_log" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"
                    remarks="Момент совершения действия">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT" remarks="Кто совершил действие (NULL для системных операций)"/>
            <column name="user_login" type="VARCHAR(100)" remarks="Логин на момент действия (денормализация для истории)"/>
            <column name="action_type" type="VARCHAR(60)" remarks="Тип действия: DOCUMENT_CREATED, PERMISSION_GRANTED и т.д.">
                <constraints nullable="false"/>
            </column>
            <column name="resource_type" type="VARCHAR(40)" remarks="Тип ресурса: DOCUMENT, SPACE, USER, GROUP, PERMISSION"/>
            <column name="resource_id" type="BIGINT" remarks="ID затронутого ресурса"/>
            <column name="details" type="TEXT" remarks="Дополнительные детали (старые/новые значения и т.п.)"/>
            <column name="ip_address" type="VARCHAR(45)" remarks="IP-адрес клиента (IPv4/IPv6)"/>
        </createTable>

        <createIndex tableName="audit_log" indexName="idx_audit_log_user">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="audit_log" indexName="idx_audit_log_created_at">
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="audit_log" indexName="idx_audit_log_action_type">
            <column name="action_type"/>
        </createIndex>

        <rollback>
            <dropTable tableName="audit_log"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
