# Application
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET_KEY=change-me-minimum-32-characters-for-local-dev
JWT_EXPIRATION_MS=86400000
LOG_LEVEL=INFO
LOG_FORMAT=text

# Postgres
POSTGRES_DB=knowledge_base
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=strong_password
POSTGRES_PORT=5433

# LOCAL: code is mounted from host, changes visible immediately (recommended for development)
# SSH: code is cloned inside container (useful for clean environments or CI/CD)
SOURCE_MODE=local

# SSH-only configuration (only needed if SOURCE_MODE=ssh)
GIT_REPO_URL=git@github.com:username/project.git
GIT_BRANCH=main
AUTO_PULL=false  # Set to 'true' to auto-pull updates on each container start

# Optional extras (compose profile: extras)
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
AUTO_OPEN_SHELL=true
SKIP_BUILD=false
# Host user mapping (recommended for Linux/macOS)
# Linux/macOS: UID=$(id -u), GID=$(id -g)
# This prevents file permission issues when editing code on the host
UID=1000
GID=1000

